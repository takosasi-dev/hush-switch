<!-- 追加ダイアログ(§9.1)。今セッションを持つアプリの一覧から選ぶか、exe ファイルを選んで対象に加える。 -->
<Window x:Class="HushSwitch.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリを追加" Width="360" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="音を出しているアプリ" Margin="0,0,0,6" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="追加" Click="OnAdd" IsDefault="True" IsEnabled="False"
                    AutomationProperties.AutomationId="ok" MinWidth="88" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Visibility="Collapsed" Foreground="#C42B1C"
                   AutomationProperties.AutomationId="message" TextWrapping="Wrap" Margin="0,8,0,0" />

        <Button DockPanel.Dock="Bottom" Content="exe ファイルを選ぶ…" Click="OnBrowse"
                HorizontalAlignment="Left" Margin="0,8,0,0" />

        <ListBox x:Name="Apps" SelectionChanged="OnSelectionChanged"
                 AutomationProperties.AutomationId="apps">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding CanAdd}" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="24" Height="24" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource IconPlaceholder}" FontSize="18" />
                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
