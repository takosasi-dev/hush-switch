<!-- 終了の確認(FR-13)。ミュートのある対象が残っているときに、解除して終了 / このまま終了 / キャンセル を選ぶ。 -->
<Window x:Class="HushSwitch.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HushSwitch の終了" Width="440" Height="230" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="解除して終了" Click="OnUnmute" IsDefault="True"
                    AutomationProperties.AutomationId="unmute" MinWidth="104" />
            <Button Content="このまま終了" Click="OnLeave"
                    AutomationProperties.AutomationId="leave" MinWidth="104" Margin="8,0,0,0" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
        </StackPanel>

        <CheckBox x:Name="RememberCheck" DockPanel.Dock="Bottom" Content="今後確認しない"
                  AutomationProperties.AutomationId="remember" Margin="0,12,0,0" />

        <TextBlock TextWrapping="Wrap"
                   Text="ミュート中のアプリがあります。このまま終了すると、次に解除するまでミュートのままになります。" />
    </DockPanel>
</Window>
