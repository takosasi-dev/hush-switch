<!-- 設定の画面。変えたらその場で保存して反映する(OK・キャンセルは無い)。 -->
<Window x:Class="HushSwitch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="480" Height="700" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" IsDefault="True" MinWidth="88" />
            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.7" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="見た目" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox x:Name="DesignBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      AutomationProperties.Name="デザイン" AutomationProperties.AutomationId="design">
                                <ComboBoxItem Content="標準" Tag="standard" />
                                <ComboBoxItem Content="コンパクト" Tag="compact" />
                                <ComboBoxItem Content="大きめ" Tag="large" />
                                <ComboBoxItem Content="タイル" Tag="tiles" />
                                <ComboBoxItem Content="ゲーミング" Tag="gaming" />
                            </ComboBox>
                            <TextBlock Text="デザイン" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      AutomationProperties.Name="配色" AutomationProperties.AutomationId="theme">
                                <ComboBoxItem Content="Windows に合わせる" Tag="system" />
                                <ComboBoxItem Content="ライト" Tag="light" />
                                <ComboBoxItem Content="ダーク" Tag="dark" />
                            </ComboBox>
                            <TextBlock x:Name="ThemeLabel" Text="配色" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <!-- 項目は SettingsWindow.AccentChoices。色の丸をテンプレートで描く(選んだあとの欄にも出るように) -->
                            <ComboBox x:Name="AccentBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      SelectedValuePath="Key"
                                      AutomationProperties.Name="アクセントの色" AutomationProperties.AutomationId="accent">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="アクセントの色" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <ComboBox x:Name="TextSizeBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      AutomationProperties.Name="文字の大きさ" AutomationProperties.AutomationId="text-size">
                                <ComboBoxItem Content="小" Tag="small" />
                                <ComboBoxItem Content="中" Tag="medium" />
                                <ComboBoxItem Content="大" Tag="large" />
                                <ComboBoxItem Content="特大" Tag="xlarge" />
                            </ComboBox>
                            <TextBlock Text="文字の大きさ" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="不透明度" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnChanged" VerticalAlignment="Center"
                                    AutomationProperties.Name="不透明度" AutomationProperties.AutomationId="opacity" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="表示する物" FontWeight="SemiBold" Margin="0,12,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="IconsBox" Content="アプリのアイコン" Click="OnChanged" AutomationProperties.AutomationId="show-icons" />
                        <CheckBox x:Name="StatusBox" Content="状態(ミュート中 など)" Click="OnChanged" Margin="0,4,0,0" AutomationProperties.AutomationId="show-status" />
                        <CheckBox x:Name="SummaryBox" Content="上の件数" Click="OnChanged" Margin="0,4,0,0" AutomationProperties.AutomationId="show-summary" />
                        <CheckBox x:Name="RemoveBox" Content="削除のボタン(隠しても、行の右クリックで削除できます)" Click="OnChanged" Margin="0,4,0,0" AutomationProperties.AutomationId="show-remove" />
                        <CheckBox x:Name="TopBox" Content="常に手前に表示する" Click="OnChanged" Margin="0,4,0,0"
                                  AutomationProperties.AutomationId="top" />
                    </StackPanel>
                </Border>

                <TextBlock Text="カテゴリー" FontWeight="SemiBold" Margin="0,12,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                                   Text="アプリをカテゴリーに入れるには、一覧の行を右クリックします。右の欄はカテゴリーごとのホットキーです(欄を選んでキーを押す。Delete で消す)" />
                        <ItemsControl x:Name="CategoryList" AutomationProperties.AutomationId="categories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" Click="OnCategoryRemove"
                                                FontFamily="{StaticResource IconFont}" FontSize="14" Padding="8" Margin="6,0,0,0"
                                                ToolTip="カテゴリーを消す" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} を消す'}" />
                                        <TextBox DockPanel.Dock="Right" Width="140" Margin="6,0,0,0" Text="{Binding Hotkey, Mode=OneTime}"
                                                 IsReadOnly="True" InputMethod.IsInputMethodEnabled="False"
                                                 PreviewKeyDown="OnHotkeyKey" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                                                 ToolTip="ホットキー(欄を選んでキーを押す。Delete で消す)"
                                                 AutomationProperties.Name="{Binding Name, StringFormat='{}{0} のホットキー'}" />
                                        <TextBox Text="{Binding Name, Mode=OneTime}" MaxLength="20" LostKeyboardFocus="OnCategoryRename"
                                                 AutomationProperties.Name="カテゴリーの名前" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="AddCategoryButton" DockPanel.Dock="Right" Content="追加" Click="OnCategoryAdd" MinWidth="72" Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="category-add" />
                            <TextBox x:Name="NewCategoryBox" MaxLength="20" AutomationProperties.Name="新しいカテゴリーの名前"
                                     AutomationProperties.AutomationId="category-new" />
                        </DockPanel>
                        <TextBlock x:Name="CategoryNote" TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="起動と終了" FontWeight="SemiBold" Margin="0,12,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="AutostartBox" Content="Windows の起動時に自動で起動する" Click="OnAutostart"
                                  AutomationProperties.AutomationId="autostart" />
                        <CheckBox x:Name="StartInTrayBox" Content="起動したとき、ウィンドウを出さずにトレイに格納する" Click="OnChanged"
                                  Margin="0,4,0,0" AutomationProperties.AutomationId="start-in-tray" />
                        <DockPanel Margin="0,10,0,0">
                            <ComboBox x:Name="CloseBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      AutomationProperties.Name="× を押したとき" AutomationProperties.AutomationId="close">
                                <ComboBoxItem Content="トレイに格納する" Tag="tray" />
                                <ComboBoxItem Content="終了する" Tag="exit" />
                            </ComboBox>
                            <TextBlock Text="× を押したとき" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <ComboBox x:Name="ExitBox" DockPanel.Dock="Right" MinWidth="190" SelectionChanged="OnChanged"
                                      AutomationProperties.Name="ミュートが残っているときの終了" AutomationProperties.AutomationId="on-exit">
                                <ComboBoxItem Content="毎回確認する" Tag="ask" />
                                <ComboBoxItem Content="ミュートを残して終了する" Tag="leave" />
                                <ComboBoxItem Content="解除してから終了する" Tag="unmute" />
                            </ComboBox>
                            <TextBlock Text="ミュートが残っているときの終了" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="AutostartNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="ホットキー" FontWeight="SemiBold" Margin="0,12,0,6" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="すべてミュート / すべて解除(どの画面にいても効きます)" TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="なしにする" Click="OnHotkeyClear" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="hotkey-clear" />
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" InputMethod.IsInputMethodEnabled="False"
                                     PreviewKeyDown="OnHotkeyKey" GotKeyboardFocus="OnHotkeyFocus" LostKeyboardFocus="OnHotkeyBlur"
                                     AutomationProperties.Name="ホットキー" AutomationProperties.AutomationId="hotkey" />
                        </DockPanel>
                        <TextBlock x:Name="HotkeyNote" TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                                   Text="欄を選んで、キーを押してください(Ctrl か Alt を含む組み合わせ、または F1〜F24)。決めたキーは、ほかのアプリでは使えなくなります" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="設定のフォルダを開く" Click="OnOpenSettings" />
                    <Button Content="ログのフォルダを開く" Click="OnOpenLogs" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
